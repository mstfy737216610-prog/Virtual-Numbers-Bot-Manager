# Environment variables example

# 5SIM API key (if using 5sim)
FIVE_SIM_API_KEY=""

# HeroSMS API key (if using HeroSMS)
HEROSMS_API_KEY=""

# Bot settings
BOT_ENV=development

# App url (used by web UI callbacks, if any)
APP_URL=""

# (Optional) Firebase config if you choose to enable Firebase for runtime storage
# FIREBASE_API_KEY=""
# FIREBASE_AUTH_DOMAIN=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_STORAGE_BUCKET=""
# FIREBASE_MESSAGING_SENDER_ID=""
# FIREBASE_APP_ID=""
